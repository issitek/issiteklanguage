# Proyecto Compose propio. Copiar a infra/.env y cambiar los secretos.
COMPOSE_PROJECT_NAME=issitek-language

# Postgres (host 5433 para no chocar con otros proyectos)
POSTGRES_USER=issitek
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=issitek_language
POSTGRES_PORT=5433

# Redis
REDIS_PORT=6380

# Almacenamiento S3 (host 9100).
# Dev: moto (servicio `storage`). Producción: apuntar a MinIO/Garage/SeaweedFS/S3.
MINIO_ROOT_USER=issitek
MINIO_ROOT_PASSWORD=cambia-este-secreto
MINIO_API_PORT=9100
# Endpoint interno (contenedor → contenedor) y público (navegador).
# MINIO_ENDPOINT=storage:9000
# El proxy /s3 de nginx mantiene el mismo origen y evita CORS en desarrollo.
MINIO_PUBLIC_ENDPOINT=localhost:8090/s3

# API / web (host)
API_PORT=8000
WEB_PORT=8090

# JWT
JWT_SECRET=cambia-este-secreto-largo
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# TTS de referencia: fake para desarrollo sin Kokoro; kokoro para el laboratorio.
TTS_PROVIDER=fake
TTS_LOCAL_URL=http://host.docker.internal:9082
TTS_DEFAULT_VOICE=af_heart
# Kokoro real (overlay docker-compose.kokoro.yml); puerto solo para depuración.
KOKORO_PORT=9083

# Evaluación fonética: desactivada hasta aprobar el gate §13.5.
PRONUNCIATION_EVAL_ENABLED=false
PRONUNCIATION_EVAL_ENGINE=fake

# Retención de grabaciones del alumno
RECORDING_RETENTION_DAYS=30
RECORDING_MAX_SECONDS=15
# Worker de purga (cada hora por defecto)
WORKER_INTERVAL_SECONDS=3600
WORKER_RUN_ONCE=false
