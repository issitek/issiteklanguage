# Laboratorio talkdrill — configuración de ejemplo
# Copiar a .env.lab y ajustar (NUNCA commitear .env.lab)
# Secretos largos y aleatorios; el laboratorio NO publica puertos (salvo coturn).

# Token de Laboratorio (cabecera x-lab-token para /ice-credentials)
LAB_TOKEN=cambia-esto-por-un-token-largo

# coturn (REST-only HMAC) — realm y secreto REALES solo en .env.lab
TURN_SHARED_SECRET=cambia-esto-por-32-bytes-aleatorios
TURN_REALM=talkdrill-lab
TURN_PORT=3478
TURN_MIN_PORT=49152
TURN_MAX_PORT=49200

# LLM local (llama.cpp en P100, red del laboratorio)
# Imagen: ghcr.io/ggml-org/llama.cpp:server-cuda
LLM_HOST_PORT=9080
LLM_MODEL_FILE=Qwen3.5-4B-Q4_K_M.gguf
LLM_MODEL_DIR=/home/ancko/models/qwen3.5-4b
LLM_CTX=8192

# aiortc lab server
LAB_SERVER_HOST_PORT=9090
# URL que usa la página de prueba para hablar con el servidor de lab
LAB_SERVER_URL=http://127.0.0.1:9090
